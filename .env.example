# Configurazione del Server
PORT=4000

# Percorso delle configurazioni VPN
VPN_CONFIG_PATH=./vpn_configs

# Porta di gestione OpenVPN (se utilizzata)
VPN_MANAGEMENT_PORT=7505

# Modalità debug
DEBUG=false

# Autenticazione interfaccia web
# Impostare AUTH_ENABLED=false per disabilitare (sconsigliato)
AUTH_ENABLED=true
AUTH_USERNAME=admin
# Se non impostata, viene generata una password casuale ad ogni avvio
AUTH_PASSWORD=

# Segreto per le sessioni (impostare un valore casuale lungo in produzione)
SESSION_SECRET=

# Impostare a true solo se il server è servito via HTTPS
COOKIE_SECURE=false

# Rate limiting API
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=10

# HTTPS (richiede certificato e chiave)
# Generare un certificato self-signed con:
#   openssl req -x509 -newkey rsa:2048 -keyout key.pem -out cert.pem -days 365 -nodes
HTTPS_ENABLED=false
SSL_CERT_PATH=
SSL_KEY_PATH=

# Directory dei log dell'applicazione
LOG_DIR=./logs
